#!/bin/sh
# Runs Python with numpy (what the motion-studio audio scripts need). setup.sh decides which interpreter.
# content-engine (Windows): prefers the repo's shared venv library/.venv (signed Python 3.12, numpy installed).
D="$(cd "$(dirname "$0")/.." && pwd)"
REPO="$(cd "$D/../../.." && pwd)"
if [ -x "$D/.venv/bin/python" ]; then exec "$D/.venv/bin/python" "$@"; fi
if [ -x "$D/.venv/Scripts/python.exe" ]; then exec "$D/.venv/Scripts/python.exe" "$@"; fi
if [ -x "$REPO/library/.venv/Scripts/python.exe" ]; then exec "$REPO/library/.venv/Scripts/python.exe" "$@"; fi
if [ -x "$REPO/library/.venv/bin/python" ]; then exec "$REPO/library/.venv/bin/python" "$@"; fi
if [ -f "$D/.python" ]; then exec "$(cat "$D/.python")" "$@"; fi
# never the Windows Store "python3" stub
if command -v python >/dev/null 2>&1; then exec python "$@"; fi
exec python3 "$@"
