# ===== Carousel Generator — environment =====
# 1. Rename this file to  .env
# 2. Paste your kie.ai API key below (get one at https://kie.ai/api-key)
# 3. Put it in the content-engine repo root (.env is gitignored). Free path needs no key.

KIE_API_KEY=your_kie_ai_key_here

# --- Optional overrides (defaults are fine) ---
# CAROUSEL_MODEL=nano-banana-pro      # kie model for backgrounds (nano-banana-pro | nano-banana-2 | gpt-image-2-image-to-image)
# CAROUSEL_BG_ASPECT=4:5              # 1:1 2:3 3:4 4:5 9:16 16:9 ...
# CAROUSEL_BG_RESOLUTION=2K           # 1K | 2K | 4K
# CAROUSEL_WORKERS=3                  # parallel background generations
# CAROUSEL_STYLE_REFERENCE_URL=https://...   # PAID path only: a PUBLIC url you host (auto-upload removed)
