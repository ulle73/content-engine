# Never commit real secrets. Existing process OPENAI_API_KEY is reused.
OPENAI_MODEL=gpt-5.6-luna
SECRET_KEY=replace-with-a-random-secret
POSTIZ_ENCRYPTION_SECRET=replace-with-a-separate-random-secret
APP_URL=http://127.0.0.1:8765
DATABASE_URL=postgres://content:password@127.0.0.1:5432/content
# Optional direct URL for schema migrations; mandatory for non-Neon transaction poolers.
# Neon -pooler hosts are converted to their direct host by migrate_locked.py.
DATABASE_URL_UNPOOLED=
# Required only to claim the first administrator on a public HTTPS deployment.
# Render generates this automatically; copy it from Render's Environment page into the setup form.
SETUP_TOKEN=

# Optional account metadata; only the token is needed for REST authentication.
APIFY_USER_ID=
APIFY_API_TOKEN=
# Shared per-company daily reservation across organic and paid scrapers (USD).
SCRAPER_DAILY_BUDGET_USD=1.00
# New/changed intelligence classifications per company/day; cache hits are free.
INTELLIGENCE_DAILY_ANALYSES=12

# Media: R2 is selected automatically when an endpoint/account is configured.
# MEDIA_STORAGE=local is allowed only on localhost. Public deployments require r2.
MEDIA_STORAGE=r2
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# Optional alternative to R2_ENDPOINT_URL: R2_ACCOUNT_ID
OPENAI_IMAGE_MODEL=gpt-image-2
# Reuse OPENAI_API_KEY from the server environment.
# Golfkuponger production Higgsfield credential. Current Higgsfield UI can provide
# one complete API credential via "Copy API Key"; put that complete value here.
HIGGSFIELD_API_KEY_GK=
# Optional legacy split-secret fallback. Leave blank when HIGGSFIELD_API_KEY_GK is complete.
HIGGSFIELD_API_SECRET_GK=
# Backwards-compatible generic names; new deployments should prefer the _GK names above.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Per-video ceiling; the API estimate is checked before paid submission.
HIGGSFIELD_MAX_USD=2
HIGGSFIELD_WEBHOOK_ENABLED=false

# ChatGPT Business MCP. OAuth is hosted by Content Engine itself and uses the normal Django user login.
MCP_REQUIRED_SCOPE=content-engine.operate
# Normally omitted on Render; RENDER_EXTERNAL_URL determines both OAuth issuer and <url>/mcp automatically.
MCP_RESOURCE_URL=
# DCR compatibility fallback is restricted to explicit HTTPS OpenAI/ChatGPT callback hosts.
MCP_OAUTH_ALLOWED_CLIENT_HOSTS=chatgpt.com,openai.com,connectors.api.openai.org
# Local tests only. Never enable this on a public deployment.
MCP_ALLOW_INSECURE_LOCAL=false
MCP_DEV_BEARER_TOKEN=
MCP_DEV_USER_EMAIL=
