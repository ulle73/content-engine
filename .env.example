# Existing process OPENAI_API_KEY is reused; never committed.
OPENAI_MODEL=gpt-5.6-luna
SECRET_KEY=replace-with-a-random-secret
ENCRYPTION_KEY_SALT=replace-with-a-random-salt
APP_URL=https://content.your-domain.se
ALLOWED_HOSTS=content.your-domain.se
DATABASE_URL=postgres://content:password@127.0.0.1:5432/content
MEDIA_ROOT=/var/lib/content-engine/media
EMAIL_BACKEND_TYPE=smtp
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
PLATFORM_FACEBOOK_APP_ID=
PLATFORM_FACEBOOK_APP_SECRET=
