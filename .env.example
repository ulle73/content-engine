# Never commit real secrets. Existing process OPENAI_API_KEY is reused.
OPENAI_MODEL=gpt-5.6-luna
SECRET_KEY=replace-with-a-random-secret
POSTIZ_ENCRYPTION_SECRET=replace-with-a-separate-random-secret
APP_URL=http://127.0.0.1:8765
DATABASE_URL=postgres://content:password@127.0.0.1:5432/content
# Required only to claim the first administrator on a public HTTPS deployment.
# Render generates this automatically; copy it from Render's Environment page into the setup form.
SETUP_TOKEN=

# Optional account metadata; only the token is needed for REST authentication.
APIFY_USER_ID=
APIFY_API_TOKEN=
# Shared per-company daily reservation across organic and paid scrapers (USD).
SCRAPER_DAILY_BUDGET_USD=1.00
# New/changed intelligence classifications per company/day; cache hits are free.
INTELLIGENCE_DAILY_ANALYSES=12

# Media: R2 is selected automatically when an endpoint/account is configured.
# MEDIA_STORAGE=local is allowed only on localhost. Public deployments require r2.
MEDIA_STORAGE=r2
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# Optional alternative to R2_ENDPOINT_URL: R2_ACCOUNT_ID
OPENAI_IMAGE_MODEL=gpt-image-2
# Reuse OPENAI_API_KEY from the server environment.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Per-video ceiling; the API estimate is checked before paid submission.
HIGGSFIELD_MAX_USD=2

# ChatGPT Business MCP resource server (production).
# Use your OIDC/OAuth issuer, for example Microsoft Entra ID. The token audience must match the API app registration.
MCP_AUTH_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
MCP_AUTH_AUDIENCE=YOUR_CONTENT_ENGINE_API_AUDIENCE
# Optional. If omitted the server reads jwks_uri from the issuer's OIDC discovery document.
MCP_AUTH_JWKS_URL=
# Claim mapped to the existing Content Engine Django user's email/username.
MCP_AUTH_USER_CLAIM=email
# Optional API scope required in access tokens, e.g. content-engine.operate.
MCP_REQUIRED_SCOPE=
# Normally omitted on Render; RENDER_EXTERNAL_URL is converted to <url>/mcp automatically.
MCP_RESOURCE_URL=
# Local tests only. Never enable this on a public deployment.
MCP_ALLOW_INSECURE_LOCAL=false
MCP_DEV_BEARER_TOKEN=
MCP_DEV_USER_EMAIL=
