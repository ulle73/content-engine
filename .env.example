# Never commit real secrets. Existing process OPENAI_API_KEY is reused.
OPENAI_MODEL=gpt-5.6-luna
SECRET_KEY=replace-with-a-random-secret
POSTIZ_ENCRYPTION_SECRET=replace-with-a-separate-random-secret
APP_URL=http://127.0.0.1:8765
DATABASE_URL=postgres://content:password@127.0.0.1:5432/content
# Required only to claim the first administrator on a public HTTPS deployment.
# Render generates this automatically; copy it from Render's Environment page into the setup form.
SETUP_TOKEN=

# Optional account metadata; only the token is needed for REST authentication.
APIFY_USER_ID=
APIFY_API_TOKEN=
